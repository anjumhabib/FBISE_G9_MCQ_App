<section id="student-list" class="card report-card admin-table-card" aria-labelledby="student-list-title">
    <div class="admin-section-heading">
        <h2 id="student-list-title">Student performance</h2>
        <div class="pills screen-only" role="group" aria-label="Student report">
            <button type="button" class="pill active" data-report-tab="all" aria-pressed="true">All students</button>
            <button type="button" class="pill" data-report-tab="at-risk" aria-pressed="false">At risk</button>
            <button type="button" class="pill" data-report-tab="inactive" aria-pressed="false">Inactive</button>
        </div>
    </div>
    <p id="student-tab-description" class="muted" hidden></p>
    <div id="student-table"></div>
    <div id="student-pages"></div>
</section>
<div id="student-detail" class="admin-report" hidden>
    <section class="card report-card" aria-label="Student details">
        <div class="admin-section-heading">
            <h2 id="student-name"></h2>
            <a class="button secondary small screen-only" id="student-back" href="/admin/students">Back to students</a>
        </div>
        <dl id="student-profile" class="admin-facts"></dl>
    </section>
    <section class="card report-card admin-table-card" aria-labelledby="student-subjects-title">
        <h2 id="student-subjects-title">Subject breakdown</h2>
        <div id="student-subjects"></div>
    </section>
    <section class="card report-card admin-table-card" aria-labelledby="student-attempts-title">
        <h2 id="student-attempts-title">Test history</h2>
        <div id="student-attempts"></div>
        <div id="student-attempt-pages"></div>
    </section>
</div>
@section Scripts {
    <script type="module" src="~/js/admin/students.js" asp-append-version="true"></script>
}
